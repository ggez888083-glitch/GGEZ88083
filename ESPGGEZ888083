MasterButton.MouseButton1Click:Connect(function()
    espActive = not espActive
    MasterButton.Text = espActive and "ปิดใช้งานระบบทั้งหมด 🔴" or "เปิดใช้งานระบบทั้งหมด 🟢"
    MasterButton.BackgroundColor3 = espActive and Color3.fromRGB(200, 50, 50) or Color3.fromRGB(40, 140, 40)
    if not espActive then
        for _, player in ipairs(Players:GetPlayers()) do if player.Character then removeEntityESP(player.Character) end end
        for _, obj in ipairs(Workspace:GetChildren()) do if obj:IsA("Model") then removeEntityESP(obj) end end
    else
        refreshAllESP()
    end
end)

