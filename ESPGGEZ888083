-- [[ Smart ESP V10 - ส่วนที่ 2: แกนประมวลผลถอดแบบสคริปต์ต้นฉบับ Watermelon 100% ]]
function getV10SmartRole(player, targetCharacter)
    local backpack = player and player:FindFirstChild("Backpack") or nil
    local charName = string.lower(targetCharacter.Name)
    local hum = targetCharacter:FindFirstChildOfClass("Humanoid")

    -- [[ ระบบดักจับและสแกนอาวุธเชิงลึก (ถอดแบบกลไกจากสคริปต์ต้นฉบับ Watermelon 100%) ]]
    local function findWeapons(folder)
        if not folder then return nil end
        for _, item in ipairs(folder:GetChildren()) do
            if item:IsA("Tool") then
                local nameLower = string.lower(item.Name)
                if string.find(nameLower, "knife") or string.find(nameLower, "blade") or string.find(nameLower, "slasher") or item:FindFirstChild("KnifeScript") then
                    return "Murderer"
                elseif string.find(nameLower, "gun") or string.find(nameLower, "revolver") or string.find(nameLower, "pistol") or item:FindFirstChild("GunScript") then
                    return "Sheriff"
                end
            end
        end
        return nil
    end

    local weaponDetected = findWeapons(backpack) or findWeapons(targetCharacter)

    -- [[ คัดกรองบทบาทและปิดช่องโหว่ตามโหมดที่ผู้ใช้งานกดเลือก ]]
    if selectedMode == "MM2" then
        if weaponDetected then return weaponDetected end
        return "Innocent" -- ล็อกเป็นผู้รอดชีวิต (สีเขียว) เสมอตามระบบสคริปต์ต้นฉบับ Watermelon 100%
    elseif selectedMode == "SurvivalNoSheriff" then
        if string.find(charName, "huggy") or string.find(charName, "wuggy") or string.find(charName, "monster") or string.find(charName, "killer") or string.find(charName, "bot") or string.find(charName, "villain") or (hum and hum.MaxHealth > 200) or weaponDetected == "Murderer" then
            return "Villain"
        end
        return "Innocent"
    elseif selectedMode == "Team" then
        return "TeamPlayer"
    else
        local currentPower = "หมัดเปล่า"
        if targetCharacter then
            for _, item in ipairs(targetCharacter:GetChildren()) do
                if item:IsA("Tool") then currentPower = item.Name break end
            end
        end
        if currentPower == "หมัดเปล่า" and backpack then
            for _, item in ipairs(backpack:GetChildren()) do
                if item:IsA("Tool") then currentPower = item.Name break end
            end
        end
        return "RegularPlayer", currentPower
    end
end

function removeEntityESP(character)
    if character:FindFirstChild("REAL_V10_Chams") then character["REAL_V10_Chams"]:Destroy() end
    local hrp = character:WaitForChild("HumanoidRootPart", 2)
    if hrp and hrp:FindFirstChild("REAL_V10_Billboard") then hrp["REAL_V10_Billboard"]:Destroy() end
end

function applyVisualESP(name, character, associatedPlayer)
    local hrp = character:WaitForChild("HumanoidRootPart", 5)
    if not hrp then return end
    if character:FindFirstChild("REAL_V10_Chams") then character["REAL_V10_Chams"]:Destroy() end
    if hrp:FindFirstChild("REAL_V10_Billboard") then hrp:FindFirstChild("REAL_V10_Billboard"):Destroy() end
    if not espActive then return end
    
    local role, power = getV10SmartRole(associatedPlayer, character)
    local chamsColor = Color3.fromRGB(240, 240, 240)
    local roleText = "ผู้เล่นทั่วไป ⚔️"
    
    if role == "Murderer" then
        chamsColor = Color3.fromRGB(255, 50, 50)
        roleText = "ฆาตกร ❌"
    elseif role == "Villain" then
        chamsColor = Color3.fromRGB(255, 50, 50)
        roleText = "ตัวร้าย (Villain) ❌"
    elseif role == "Sheriff" then
        chamsColor = Color3.fromRGB(50, 150, 255)
        roleText = "นายอำเภอ 🎖️"
    elseif role == "Innocent" then
        chamsColor = Color3.fromRGB(50, 255, 50)
        roleText = "ผู้รอดชีวิต 👤"
    elseif role == "TeamPlayer" and associatedPlayer then
        chamsColor = associatedPlayer.TeamColor.Color
        roleText = "ทีม: " .. (associatedPlayer.Team and associatedPlayer.Team.Name or "ไม่มีทีม")
    elseif role == "RegularPlayer" then
        chamsColor = Color3.fromRGB(240, 240, 240)
        roleText = "ผู้เล่นทั่วไป | พลัง: " .. (power or "ไม่มี")
    end
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "REAL_V10_Chams"
    highlight.FillColor = chamsColor
    highlight.FillTransparency = 0.35
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character
    
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "REAL_V10_Billboard"
    billboard.Size = UDim2.new(0, 220, 0, 60)
    billboard.AlwaysOnTop = true
    billboard.ExtentsOffset = Vector3.new(0, 3, 0)
    billboard.Parent = hrp
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = chamsColor
    label.TextSize = 11
    label.Font = Enum.Font.SourceSansBold
    label.TextStrokeTransparency = 0.5
    
    local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local distanceText = ""
    if myHrp then
        local distance = math.floor((myHrp.Position - hrp.Position).Magnitude)
        distanceText = " [" .. tostring(distance) .. "ม.]"
    end
    label.Text = name .. distanceText .. "\n" .. "[ " .. roleText .. " ]"
    label.Parent = billboard
end

function refreshAllESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            applyVisualESP(player.Name, player.Character, player)
        end
    end
    if selectedMode == "SurvivalNoSheriff" then
        for _, obj in ipairs(Workspace:GetChildren()) do
            if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and not Players:GetPlayerFromCharacter(obj) and obj ~= LocalPlayer.Character then
                applyVisualESP(obj.Name, obj, nil)
            end
        end
    end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if isBinding and input.UserInputType == Enum.UserInputType.Keyboard then
        toggleKey = input.KeyCode
        KeybindButton.Text = "ปุ่มเปิด/ปิดเมนู: " .. toggleKey.Name .. " ⌨️"
        isBinding = false
        return
    end
    if input.KeyCode == toggleKey and not gameProcessed then
        uiVisible = not uiVisible
        MainFrame.Visible = uiVisible
    end
end)

